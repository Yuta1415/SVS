# SVS deployment configuration. NEVER commit this file.
# Regenerate POSTGRES_PASSWORD for every real deploy.

# Comma-separated list of frontend origins the API will accept.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database.
POSTGRES_USER=svs_user
POSTGRES_PASSWORD=svs_password
POSTGRES_DB=svs_database

# Where the deployed frontend will reach the API. Baked into the JS
# bundle at build time, so changing this requires rebuilding frontend.
FRONTEND_API_URL=http://localhost:8000
